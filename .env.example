# .env.example

# Application Configuration
APP_NAME=api-accounts
APP_ENV=development
PORT=8080

# Gin Framework
GIN_MODE=debug

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pismo_challenge
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# API Configuration
API_VERSION=v1
API_TIMEOUT=30s

# Logging
LOG_LEVEL=info
LOG_FORMAT=text